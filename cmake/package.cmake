# PUREfft's link dependencies, for PUREfft.pc and the CMake package
set(PUREFFT_ARCHIVES "")
set(PUREFFT_SYSTEM "")
set(PUREFFT_CXX FALSE)
set(seen "")
set(queue PUREfft)
while(queue)
    list(POP_FRONT queue item)
    string(REGEX REPLACE "^\\$<(LINK_ONLY|BUILD_INTERFACE):(.+)>$" "\\2" item "${item}")
    if(TARGET ${item})
        get_target_property(real ${item} ALIASED_TARGET)
        if(NOT real)
            set(real ${item})
        endif()
        if(real IN_LIST seen)
            continue()
        endif()
        list(APPEND seen ${real})
        get_target_property(type ${real} TYPE)
        if(type STREQUAL "STATIC_LIBRARY")
            list(APPEND PUREFFT_ARCHIVES ${real})
            get_target_property(sources ${real} SOURCES)
            if(sources MATCHES "\\.(cpp|cxx|cc)(;|$)")
                set(PUREFFT_CXX TRUE)
            endif()
        endif()
        get_target_property(under ${real} INTERFACE_LINK_LIBRARIES)
        if(under)
            list(APPEND queue ${under})
        endif()
    elseif(IS_ABSOLUTE "${item}")
        cmake_path(IS_PREFIX PROJECT_BINARY_DIR "${item}" NORMALIZE fetched)
        if(fetched)
            list(APPEND PUREFFT_ARCHIVES "${item}")
        else()
            list(APPEND PUREFFT_SYSTEM "${item}")
        endif()
    elseif(item MATCHES "^-")
        list(APPEND PUREFFT_SYSTEM "${item}")
    elseif(item MATCHES "^\\$<")
        message(STATUS "PUREfft: PUREfft.pc and the CMake package leave out ${item}, a link item they can't evaluate")
    elseif(item)
        list(APPEND PUREFFT_SYSTEM "-l${item}")
    endif()
endwhile()
set(cxx_runtime "")
if(PUREFFT_CXX)
    foreach(item ${CMAKE_CXX_IMPLICIT_LINK_LIBRARIES})
        if(NOT item IN_LIST CMAKE_C_IMPLICIT_LINK_LIBRARIES)
            list(APPEND cxx_runtime "-l${item}")
        endif()
    endforeach()
endif()
# hide the archives' symbols on Linux, as Pd loads externals with RTLD_GLOBAL
set(hidden "")
foreach(archive ${PUREFFT_ARCHIVES})
    if(TARGET ${archive})
        list(APPEND hidden "$<TARGET_FILE_NAME:${archive}>")
    else()
        get_filename_component(name "${archive}" NAME)
        list(APPEND hidden "${name}")
    endif()
endforeach()
list(JOIN hidden ":" hidden)
set(PUREFFT_HIDE "")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(PUREFFT_HIDE "LINKER:--exclude-libs,${hidden}")
    target_link_options(PUREfft INTERFACE "${PUREFFT_HIDE}")
endif()
get_property(multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
set(config "")
if(multi)
    set(config "/$<CONFIG>")
endif()

# purefft_pc(<file> <prefix> <libdir> <includedir> <archive ...>)
function(purefft_pc file prefix libdir includedir)
    string(REPLACE "LINKER:" "-Wl," hide "${PUREFFT_HIDE}")
    string(JOIN " " libs ${ARGN} ${PUREFFT_SYSTEM} ${cxx_runtime} ${hide})
    configure_file("${PUREFFT_DIR}/PUREfft.pc.in" "${CMAKE_CURRENT_BINARY_DIR}/${file}.in" @ONLY)
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}${config}/${file}" INPUT "${CMAKE_CURRENT_BINARY_DIR}/${file}.in")
endfunction()

# PUREfft.pc in the build tree, for pd-lib-builder
set(paths "")
foreach(archive ${PUREFFT_ARCHIVES})
    if(TARGET ${archive})
        list(APPEND paths "$<TARGET_FILE:${archive}>")
    else()
        list(APPEND paths "${archive}")
    endif()
endforeach()
purefft_pc(PUREfft.pc "${PROJECT_BINARY_DIR}" "${PROJECT_BINARY_DIR}" "${PUREFFT_DIR}/api" ${paths})

# install rules
if(PUREFFT_INSTALL)
    include(GNUInstallDirs)
    include(CMakePackageConfigHelpers)
    set(PUREFFT_LIBDIR "${CMAKE_INSTALL_LIBDIR}/PUREfft")
    set(PUREFFT_INCLUDEDIR "${CMAKE_INSTALL_INCLUDEDIR}/PUREfft")
    set(paths "")
    set(PUREFFT_LINK "")
    foreach(archive ${PUREFFT_ARCHIVES})
        if(TARGET ${archive})
            install(FILES "$<TARGET_FILE:${archive}>" DESTINATION "${PUREFFT_LIBDIR}" COMPONENT PUREfft)
            set(name "$<TARGET_FILE_NAME:${archive}>")
        else()
            install(FILES "${archive}" DESTINATION "${PUREFFT_LIBDIR}" COMPONENT PUREfft)
            get_filename_component(name "${archive}" NAME)
        endif()
        list(APPEND paths "\${libdir}/${name}")
        if(NOT archive STREQUAL "PUREfft")
            list(APPEND PUREFFT_LINK "\${PACKAGE_PREFIX_DIR}/${PUREFFT_LIBDIR}/${name}")
        endif()
    endforeach()
    list(APPEND PUREFFT_LINK ${PUREFFT_SYSTEM} ${cxx_runtime})
    if(TARGET ipp_signal)
        install(FILES "${IPP_LICENSE}" DESTINATION "${PUREFFT_LIBDIR}" RENAME IPP-LICENSE.txt COMPONENT PUREfft)
    endif()
    install(FILES api/fft.h api/spectrum.h DESTINATION "${PUREFFT_INCLUDEDIR}" COMPONENT PUREfft)
    purefft_pc(install/PUREfft.pc "${CMAKE_INSTALL_PREFIX}" "\${prefix}/${PUREFFT_LIBDIR}" "\${prefix}/${PUREFFT_INCLUDEDIR}" ${paths})
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}${config}/install/PUREfft.pc" DESTINATION "${CMAKE_INSTALL_LIBDIR}/pkgconfig" COMPONENT PUREfft)
    configure_package_config_file(PUREfftConfig.cmake.in "${CMAKE_CURRENT_BINARY_DIR}/install/PUREfftConfig.cmake.in"
                                  INSTALL_DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/PUREfft" PATH_VARS PUREFFT_LIBDIR PUREFFT_INCLUDEDIR)
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}${config}/install/PUREfftConfig.cmake" INPUT "${CMAKE_CURRENT_BINARY_DIR}/install/PUREfftConfig.cmake.in")
    write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/install/PUREfftConfigVersion.cmake" COMPATIBILITY AnyNewerVersion)
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}${config}/install/PUREfftConfig.cmake" "${CMAKE_CURRENT_BINARY_DIR}/install/PUREfftConfigVersion.cmake"
            DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/PUREfft" COMPONENT PUREfft)
endif()
