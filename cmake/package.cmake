# K2FFT's link dependencies, for K2FFT.pc and the CMake package
set(K2FFT_ARCHIVES "")
set(K2FFT_SYSTEM "")
set(K2FFT_CXX FALSE)
set(seen "")
set(queue K2FFT)
while(queue)
    list(POP_FRONT queue item)
    string(REGEX REPLACE "^\\$<(LINK_ONLY|BUILD_INTERFACE):(.+)>$" "\\2" item "${item}")
    if(item MATCHES "^::@")
        continue() # ::@(<dir>) ... ::@, CMake's wrapping of items linked from another directory (cmake/pffft.cmake's m)
    endif()
    if(TARGET ${item})
        get_target_property(real ${item} ALIASED_TARGET)
        if(NOT real)
            set(real ${item})
        endif()
        if(real IN_LIST seen)
            continue()
        endif()
        list(APPEND seen ${real})
        get_target_property(type ${real} TYPE)
        if(type STREQUAL "STATIC_LIBRARY")
            list(APPEND K2FFT_ARCHIVES ${real})
            get_target_property(sources ${real} SOURCES)
            if(sources MATCHES "\\.(cpp|cxx|cc)(;|$)")
                set(K2FFT_CXX TRUE)
            endif()
        endif()
        get_target_property(under ${real} INTERFACE_LINK_LIBRARIES)
        if(under)
            list(APPEND queue ${under})
        endif()
    elseif(IS_ABSOLUTE "${item}")
        cmake_path(IS_PREFIX PROJECT_BINARY_DIR "${item}" NORMALIZE fetched)
        if(fetched)
            list(APPEND K2FFT_ARCHIVES "${item}")
        else()
            list(APPEND K2FFT_SYSTEM "${item}")
        endif()
    elseif(item MATCHES "^-")
        list(APPEND K2FFT_SYSTEM "${item}")
    elseif(item MATCHES "^\\$<")
        message(STATUS "K2FFT: K2FFT.pc and the CMake package leave out ${item}, a link item they can't evaluate")
    elseif(item)
        list(APPEND K2FFT_SYSTEM "-l${item}")
    endif()
endwhile()
set(cxx_runtime "")
if(K2FFT_CXX)
    foreach(item ${CMAKE_CXX_IMPLICIT_LINK_LIBRARIES})
        if(NOT item IN_LIST CMAKE_C_IMPLICIT_LINK_LIBRARIES)
            list(APPEND cxx_runtime "-l${item}")
        endif()
    endforeach()
endif()
# hide the archives' symbols on Linux, as Pd loads externals with RTLD_GLOBAL
set(hidden "")
foreach(archive ${K2FFT_ARCHIVES})
    if(TARGET ${archive})
        list(APPEND hidden "$<TARGET_FILE_NAME:${archive}>")
    else()
        get_filename_component(name "${archive}" NAME)
        list(APPEND hidden "${name}")
    endif()
endforeach()
list(JOIN hidden ":" hidden)
set(K2FFT_HIDE "")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(K2FFT_HIDE "LINKER:--exclude-libs,${hidden}")
    target_link_options(K2FFT INTERFACE "${K2FFT_HIDE}")
endif()
get_property(multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
set(config "")
if(multi)
    set(config "/$<CONFIG>")
endif()

# k2fft_pc(<file> <prefix> <libdir> <includedir> <archive ...>)
function(k2fft_pc file prefix libdir includedir)
    string(REPLACE "LINKER:" "-Wl," hide "${K2FFT_HIDE}")
    string(JOIN " " libs ${ARGN} ${K2FFT_SYSTEM} ${cxx_runtime} ${hide})
    configure_file("${K2FFT_DIR}/K2FFT.pc.in" "${CMAKE_CURRENT_BINARY_DIR}/${file}.in" @ONLY)
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}${config}/${file}" INPUT "${CMAKE_CURRENT_BINARY_DIR}/${file}.in")
endfunction()

# K2FFT.pc in the build tree, for pd-lib-builder
set(paths "")
foreach(archive ${K2FFT_ARCHIVES})
    if(TARGET ${archive})
        list(APPEND paths "$<TARGET_FILE:${archive}>")
    else()
        list(APPEND paths "${archive}")
    endif()
endforeach()
k2fft_pc(K2FFT.pc "${PROJECT_BINARY_DIR}" "${PROJECT_BINARY_DIR}" "${K2FFT_DIR}/api" ${paths})

# install rules
if(K2FFT_INSTALL)
    include(GNUInstallDirs)
    include(CMakePackageConfigHelpers)
    set(K2FFT_LIBDIR "${CMAKE_INSTALL_LIBDIR}/K2FFT")
    set(K2FFT_INCLUDEDIR "${CMAKE_INSTALL_INCLUDEDIR}/K2FFT")
    set(paths "")
    set(K2FFT_LINK "")
    foreach(archive ${K2FFT_ARCHIVES})
        if(TARGET ${archive})
            install(FILES "$<TARGET_FILE:${archive}>" DESTINATION "${K2FFT_LIBDIR}" COMPONENT K2FFT)
            set(name "$<TARGET_FILE_NAME:${archive}>")
        else()
            install(FILES "${archive}" DESTINATION "${K2FFT_LIBDIR}" COMPONENT K2FFT)
            get_filename_component(name "${archive}" NAME)
        endif()
        list(APPEND paths "\${libdir}/${name}")
        if(NOT archive STREQUAL "K2FFT")
            list(APPEND K2FFT_LINK "\${PACKAGE_PREFIX_DIR}/${K2FFT_LIBDIR}/${name}")
        endif()
    endforeach()
    list(APPEND K2FFT_LINK ${K2FFT_SYSTEM} ${cxx_runtime})
    if(TARGET ipp_signal)
        install(FILES "${IPP_LICENSE}" DESTINATION "${K2FFT_LIBDIR}" RENAME IPP-LICENSE.txt COMPONENT K2FFT)
    endif()
    install(FILES api/fft.h api/k2fft.h api/spectrum.h DESTINATION "${K2FFT_INCLUDEDIR}" COMPONENT K2FFT)
    k2fft_pc(install/K2FFT.pc "${CMAKE_INSTALL_PREFIX}" "\${prefix}/${K2FFT_LIBDIR}" "\${prefix}/${K2FFT_INCLUDEDIR}" ${paths})
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}${config}/install/K2FFT.pc" DESTINATION "${CMAKE_INSTALL_LIBDIR}/pkgconfig" COMPONENT K2FFT)
    configure_package_config_file(K2FFTConfig.cmake.in "${CMAKE_CURRENT_BINARY_DIR}/install/K2FFTConfig.cmake.in"
                                  INSTALL_DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/K2FFT" PATH_VARS K2FFT_LIBDIR K2FFT_INCLUDEDIR)
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}${config}/install/K2FFTConfig.cmake" INPUT "${CMAKE_CURRENT_BINARY_DIR}/install/K2FFTConfig.cmake.in")
    write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/install/K2FFTConfigVersion.cmake" COMPATIBILITY AnyNewerVersion)
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}${config}/install/K2FFTConfig.cmake" "${CMAKE_CURRENT_BINARY_DIR}/install/K2FFTConfigVersion.cmake"
            DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/K2FFT" COMPONENT K2FFT)
endif()
