@PACKAGE_INIT@

if(NOT TARGET K2FFT::K2FFT)
    add_library(K2FFT::K2FFT STATIC IMPORTED)
    set_target_properties(K2FFT::K2FFT PROPERTIES	IMPORTED_LOCATION 					"@PACKAGE_K2FFT_LIBDIR@/$<TARGET_FILE_NAME:K2FFT>"
														INTERFACE_INCLUDE_DIRECTORIES 		"@PACKAGE_K2FFT_INCLUDEDIR@"
														INTERFACE_LINK_LIBRARIES 			"@K2FFT_LINK@"
														INTERFACE_LINK_OPTIONS 				"@K2FFT_HIDE@"
														IMPORTED_LINK_INTERFACE_LANGUAGES 	C
    )
endif()
