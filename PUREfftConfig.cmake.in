@PACKAGE_INIT@

if(NOT TARGET PUREfft::PUREfft)
    add_library(PUREfft::PUREfft STATIC IMPORTED)
    set_target_properties(PUREfft::PUREfft PROPERTIES	IMPORTED_LOCATION 					"@PACKAGE_PUREFFT_LIBDIR@/$<TARGET_FILE_NAME:PUREfft>"
														INTERFACE_INCLUDE_DIRECTORIES 		"@PACKAGE_PUREFFT_INCLUDEDIR@"
														INTERFACE_LINK_LIBRARIES 			"@PUREFFT_LINK@"
														INTERFACE_LINK_OPTIONS 				"@PUREFFT_HIDE@"
														IMPORTED_LINK_INTERFACE_LANGUAGES 	C
    )
endif()
