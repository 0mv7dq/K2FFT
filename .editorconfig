root = true

[*]
# please only ever use utf-8
charset = utf-8
indent_size =  4
indent_style = tab

[CMake*.txt]
indent_size = 4
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = false

; C and friends
[**.{c,cpp,h,hh,m,mm}]
# sorry, im a tabs guy
indent_style = tab
indent_size = 4

## let git handle proper EOL
#end_of_line = lf

trim_trailing_whitespace = true
insert_final_newline = true

#continuation_indent_size = 4

; applies only to Makefiles
[makefile]
indent_style = tab
tab_width = 4
[**.am]
indent_style = tab
tab_width = 4

[**.tcl]
indent_style = space
indent_size = 4
#continuation_indent_size = 8
#curly_bracket_next_line = false
