#!/usr/bin/env python3
# Copyright (c) 2011-2026 0MV7DQ @ The Antisonic Research Institute

# usage: python3 scripts/figure <machine dir>
# a machine's results as GFFT's figures (ICPP 2023), a set a problem class: speeds as figs. 10-12 (a row of panels, powers of
# two then the other sizes, idle then busy, GFLOPS (benchFFT's 2.5 or 5 N log2 N / t) at K2FFT's sizes evenly spaced; K2FFT
# against FFTW, the vendor's library and the libraries no rival beat at some size; its speedups in red; one legend at the
# right), setup times as fig. 13, accuracy as fig. 14; writes <machine>.png, .setup.png, .accuracy.png for srof,
# <machine>.<class>.png ... for the others, at twice the size the pages show them
import math
import os
import re
import sys

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
from matplotlib.colors import to_rgba
from matplotlib.ticker import FuncFormatter, LogLocator, NullFormatter

OURS = "K2FFT"
VENDORS = ["ipp", "mkl", "aocl", "armpl", "vdsp", "cmsis", "espdsp"]  # GFFT's second baseline
NAMES = {"fftw3": "FFTW", "ipp": "IPP", "mkl": "oneMKL", "aocl": "AOCL", "armpl": "ArmPL", "vdsp": "vDSP", "cmsis": "CMSIS-DSP",
         "espdsp": "ESP-DSP", "ne10": "Ne10", "kfr": "KFR", "pffft": "PFFFT", "kissfft": "KISS FFT"}
# GFFT's colours and markers, fig. 14's for the rest
STYLES = {OURS: ("crimson", "D"), "fftw3": ("#2ca02c", "o"), **{v: ("#2b5ca8", "v") for v in VENDORS},
          "pffft": ("#8b1e3f", "s"), "zldsp": ("#f0861d", "^"), "pocketfft": ("#5f5f5f", "*"), "kfr": ("#7b3fa0", "P"),
          "ne10": ("#17868a", "h"), "kissfft": ("#8a8a1e", "X"), "hwyfft": ("#8b5a2b", "p")}
SPARE = [("#d4a017", ">"), ("#17becf", "<"), ("#e377c2", "8"), ("black", "o")]
W, H = 3.35, 2.75  # a panel, as figs. 10-12's


def label(c):
    base, _, isa = c.partition("_")
    return NAMES.get(base, base) + ("-\n" + isa.upper() if isa else "")  # GFFT's FFTW-AVX2


def order(codes):
    """GFFT's legend order: FFTW, the vendor's, the rest, ours last"""
    return sorted(codes, key=lambda c: (c == OURS, c != "fftw3", c not in VENDORS, c))


def styles(codes):
    """each code's line: K2FFT's solid, the rest dotted as fig. 14's baselines, PFFFT's SIMD copies dashed"""
    look, used = {}, set()
    for c in sorted(codes, key=lambda c: (c != OURS, c not in STYLES, c)):
        base = c.partition("_")[0]
        copy = c not in STYLES and base in STYLES
        s = STYLES.get(c) or STYLES.get(base)
        if s is None or (not copy and s in used):
            s = next((x for x in SPARE if x not in used), SPARE[-1])
        used.add(s)
        look[c] = dict(color=s[0], marker=s[1], markersize=5.5, markerfacecolor=to_rgba(s[0], 0.35), markeredgecolor=s[0],
                       markeredgewidth=1, linewidth=1.5, linestyle="-" if c == OURS else "--" if copy else ":", zorder=3 if c == OURS else 2,
                       label=label(c))
    return look


def kind(cls):
    """a benchFFT class in GFFT's words: srof R2C, scof C2C"""
    back = cls[3:4] == "b"
    k = {"r": "C2R" if back else "R2C", "c": "inverse C2C" if back else "C2C", "k": "R2R"}.get(cls[1:2], cls)
    return ("double " if cls[:1] == "d" else "") + k + (" in-place" if cls[2:3] == "i" else "")


def sizes_of(tensor):
    """a tensor's sizes, as 64x64*16's or 1024e10's"""
    return [int(m.group()) for m in (re.match(r"\d+", d) for d in re.split(r"[x*]", tensor)) if m]


def ours(tensor):
    """K2FFT's sizes, multiples of 32"""
    s = sizes_of(tensor)
    return bool(s) and s[0] % 32 == 0


def classes(path):
    """the classes of a file's lines, in order"""
    seen = []
    if os.path.isfile(path):
        for line in open(path):
            f = line.split()
            if len(f) > 3 and f[1] not in seen:
                seen.append(f[1])
    return seen


def load(path, column, cls):
    """{code: {tensor: value}} of class cls at K2FFT's sizes"""
    data = {}
    if os.path.isfile(path):
        for line in open(path):
            f = line.split()
            if len(f) > column and f[1] == cls and ours(f[2]) and f[3] != "FAILED" and f[0] != "pffft_twin":
                data.setdefault(f[0], {})[f[2]] = float(f[column])
    return data


def vendor(m, data):
    """GFFT's second baseline: the platform's library with the most of K2FFT's sizes (CMSIS-DSP is Arm's)"""
    mine = data.get(OURS, {})
    ok = [v for v in VENDORS if v in data and (v != "cmsis" or re.search("arm|cortex", m))]
    return max(ok, key=lambda v: (sum(t in data[v] for t in mine), -VENDORS.index(v)), default=None)


def shown(m, data, cls):
    """K2FFT, FFTW, the vendor's library, and the libraries .fastest names for cls at K2FFT's sizes"""
    keep = {OURS, "fftw3", vendor(m, data)}
    if os.path.isfile(m + ".fastest"):
        for line in open(m + ".fastest"):
            f = line.split()
            if len(f) > 1 and f[0] == cls and ours(f[1].rstrip(":")):
                keep.update(line.split(":", 1)[1].split("|")[0].split())
    else:
        keep.update(data)
    return order([c for c in data if c in keep])


def ordered(tensors):
    return sorted(tensors, key=lambda t: (sizes_of(t), t))


def split(data, codes):
    """the sizes the codes did: (powers of two, the others)"""
    every = {t for c in codes for t in data.get(c, {})}
    two = {t for t in every if all(n & (n - 1) == 0 for n in sizes_of(t))}
    return ordered(two), ordered(every - two)


def plot(ax, data, codes, tensors, look):
    at = {t: i for i, t in enumerate(tensors)}
    small = dict(markersize=3.5, markeredgewidth=0.8) if len(tensors) > 24 else {}  # GFFT's had 19 sizes a panel
    for c in codes:
        points = sorted((at[t], v) for t, v in data.get(c, {}).items() if t in at and v > 0)
        if points:
            ax.plot(*zip(*points), **{**look[c], **small})


def axis(ax, tensors, ylabel, width=W):
    step = math.ceil(len(tensors) / (6.5 * width))  # what fits rotated
    ax.set_xticks(range(0, len(tensors), step))
    ax.set_xticklabels(tensors[::step], rotation=90, fontsize=7)
    ax.tick_params(axis="y", which="both", labelsize=7)
    ax.set_xlabel("Size of FFT", fontsize=7.5)
    ax.set_ylabel(ylabel, fontsize=7.5)


def speedups(d, named, tensors):
    """GFFT's "vs FFTW 1.17x AVG.": K2FFT's speed over FFTW's, the vendor's and the fastest rival's, geometric mean"""
    mine = d.get(OURS, {})
    rivals = [c for c in d if not c.startswith(OURS) and c != "hwyfft"]
    out = []
    for name, pick in [(label(c).replace("\n", ""), [c]) for c in named] + [("fastest", rivals)]:
        r, won = [], set()
        for t in tensors:
            have = [c for c in pick if d.get(c, {}).get(t, 0) > 0]
            if mine.get(t, 0) > 0 and have:
                best = max(have, key=lambda c: d[c][t])
                r.append(math.log(mine[t] / d[best][t]))
                won.add(best)
        if r and not (name == "fastest" and len(won) == 1 and won <= set(named)):
            out.append("vs %s %.2fx AVG." % (name, math.exp(sum(r) / len(r))))
    return out


def annotate(ax, lines):
    """the speedups in red at GFFT's lower or upper right, else where the lines cover them least"""
    if not lines:
        return
    pts = []
    for l in ax.lines:
        p = ax.transData.transform(l.get_xydata())
        s = np.linspace(0, len(p) - 1, 10 * len(p))
        pts.append(np.column_stack([np.interp(s, range(len(p)), p[:, 0]), np.interp(s, range(len(p)), p[:, 1])]))
    pts = np.concatenate(pts)
    r = ax.figure.canvas.get_renderer()
    best = None
    for x, y, ha, va in ((0.97, 0.03, "right", "bottom"), (0.97, 0.97, "right", "top"), (0.97, 0.5, "right", "center"),
                         (0.03, 0.03, "left", "bottom"), (0.03, 0.97, "left", "top")):
        t = ax.text(x, y, "\n".join(lines), transform=ax.transAxes, ha=ha, va=va, color="crimson", fontsize=7)
        b = t.get_window_extent(r).padded(3)
        n = np.count_nonzero((pts[:, 0] >= b.x0) & (pts[:, 0] <= b.x1) & (pts[:, 1] >= b.y0) & (pts[:, 1] <= b.y1))
        if best is None or n < best[0]:
            if best:
                best[1].remove()
            best = (n, t)
        else:
            t.remove()


def save(fig, name):
    fig.savefig(name, dpi=192, bbox_inches="tight", pad_inches=0.02)
    plt.close(fig)


def figure(m, cls, files):
    name = m if cls == "srof" else "%s.%s" % (m, cls)
    rows = [(load(f, 3, cls), s) for f, s in files]
    rows = [(d, s) for d, s in rows if d]
    if not rows:
        return
    codes = shown(m, rows[0][0], cls)
    look = styles(codes)
    named = [c for c in ("fftw3", vendor(m, rows[0][0])) if c in codes]  # GFFT's baselines

    panels = []
    for d, s in rows:
        g = {c: {t: v / 1000 for t, v in d[c].items()} for c in d}  # benchFFT's mflops
        panels += [(g, t, w + s) for t, w in zip(split(g, codes), ("powers of two", "other sizes")) if t]
    width = W if len(panels) > 2 else W - 0.23  # two such side by side as wide as four panels
    fig, axes = plt.subplots(1, len(panels), figsize=(width * len(panels) + 0.9, H), squeeze=False)
    axes = axes[0]
    for i, (ax, (g, t, w)) in enumerate(zip(axes, panels)):
        plot(ax, g, codes, t, look)
        axis(ax, t, "Performance (GFLOPS)", width)
        ax.set_title("(%s) %s, %s" % ("abcdefgh"[i], kind(cls), w), fontsize=11)
    drawn = {}
    for ax in axes:
        for h, l in zip(*ax.get_legend_handles_labels()):
            drawn.setdefault(l, h)
    labels = [look[c]["label"] for c in codes if look[c]["label"] in drawn]
    axes[-1].legend([drawn[l] for l in labels], labels, loc="upper left", bbox_to_anchor=(1.03, 0.92), fontsize=8.5)
    fig.tight_layout()
    for ax, (g, t, w) in zip(axes, panels):
        annotate(ax, speedups(g, named, t))
    save(fig, name + ".png")

    ms = {c: {t: v * 1000 for t, v in d.items() if v > 0} for c, d in load(files[0][0], 5, cls).items()}  # libbench2's, s
    three = [OURS] + named  # fig. 13's
    panels = [(t, w) for t, w in zip(split(ms, three), ("powers of two", "other sizes")) if t]
    if panels:
        fig, axes = plt.subplots(1, len(panels), figsize=(W * len(panels), H), squeeze=False)
        for i, (ax, (t, w)) in enumerate(zip(axes[0], panels)):
            plot(ax, ms, order(three), t, look)
            ax.axhline(1000, color="red", linestyle=":", linewidth=1.5)  # one second
            ax.set_yscale("log")
            axis(ax, t, "Setup time (ms)")
            ax.set_title("(%s) %s, %s" % ("ab"[i], kind(cls), w), fontsize=11)
            ax.legend(loc="best", fontsize=7, labelspacing=0.25, handlelength=1.6, borderpad=0.3, markerscale=0.8)
        fig.tight_layout()
        save(fig, name + ".setup.png")

    acc = load(m + ".accuracy", 4, cls)  # libbench2's forward rms error, as benchFFT's accuracy plots
    if acc:
        t = ordered({t for c in codes for t in acc.get(c, {})})
        fig, ax = plt.subplots(figsize=(5.4, 3.4))
        plot(ax, acc, codes, t, look)
        ax.set_yscale("log")
        ax.yaxis.set_major_locator(LogLocator(subs=(1, 2, 5)))  # less than a decade apart, mostly
        ax.yaxis.set_major_formatter(FuncFormatter(lambda v, _: "%g" % v))
        ax.yaxis.set_minor_formatter(NullFormatter())
        axis(ax, t, "rms error", 5.4)
        ax.legend(loc="best", fontsize=8.5)
        fig.tight_layout()
        save(fig, name + ".accuracy.png")


def main():
    os.chdir(sys.argv[1])
    m = os.path.basename(os.getcwd())
    if os.path.isfile(m + ".speed"):
        files = [(m + ".speed", ""), (m + ".busy.speed", ", busy")]
    elif os.path.isfile(m + ".counts.speed"):
        files = [(m + ".counts.speed", "")]
    elif os.path.isfile(m + ".cycles.speed"):
        files = [(m + ".cycles.speed", "")]
    else:
        return
    for cls in classes(files[0][0]):
        figure(m, cls, files)


main()
