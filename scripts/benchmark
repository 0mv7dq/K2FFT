#!/bin/bash
# Copyright (c) 2011-2026 0MV7DQ @ The Antisonic Research Institute

# usage: bash scripts/benchmark <build dir> <results dir> [rounds]   (default 5; K2FFT_ACCURACY=p2, accuracy at powers of two alone)
# K2FFT_CLASSES, the problems (default srofN): benchFFT's classes, precision first, N each size, :m up to m, as srofN srobN scofN
# dcobN skoNe10 srofNxN:512; each benchee does its precision's (a -d benchee double, its code w/o the -d)
# results as benchFFT's lines, "name class tensor mflops time setup" (speed.txt, busy.txt, counts.txt) and
# "name class tensor L1 L2 Linf L1 L2 Linf" (accuracy.txt); scripts/collect makes the documents from them
set -u
if [ $# -lt 2 ]; then
	sed -n 's/^# usage: //p' "$0" >&2
	exit 2
fi
B=$(cd "$1" && pwd)
D=$(sed -n 's/^K2FFT_BINARY_DIR:[A-Z]*=//p' "$B/CMakeCache.txt" 2> /dev/null)
if [ ! -f "$D/benchees.txt" ]; then
	echo "no benchees in $B: configure with K2FFT's benchmarks (K2FFT_BENCH) and build first" >&2
	exit 2
fi
mkdir -p "$2"
R=$(cd "$2" && pwd)
ROUNDS=${3:-5}
HERE=$(cd "$(dirname "$0")/.." && pwd)
TOP=$(sed -n 's/^CMAKE_HOME_DIRECTORY:[A-Z]*=//p' "$B/CMakeCache.txt")
# CMake's files and Windows' programs end their lines with CR LF
run() {
	"$@" | tr -d '\r'
}
for f in benchees sizes measures; do
	tr -d '\r' < "$D/$f.txt" > "$R/$f.txt"
done
NAMES=$(cat "$R/benchees.txt")
EMU=$(tr -d '\r' < "$D/emulator.txt" | tr ';' ' ') # a toolchain file's emulator isn't in the cache
BOARD=""
case "$EMU" in qemu-system-*) BOARD=yes;; esac # bare metal, which has count-all alone
[ -z "$EMU" ] || export K2FFT_NORACE=1 # an emulator's time isn't the target's: K2FFT plans w/o timing (kernel/race.h), qemu-user passes it on
PIN=""
if [ -z "$EMU" ] && command -v taskset > /dev/null && [ "$(nproc 2> /dev/null || echo 1)" -gt 1 ]; then
	PIN="taskset -c 1" # one core, like Pd's DSP thread
fi
rm -f "$R/speed.txt" "$R/busy.txt" "$R/counts.txt" "$R/accuracy.txt" "$R/summary.txt"
CLASSES=${K2FFT_CLASSES:-srofN}
# libbench2's mflops.c: 5 N log2 N (complex) or 2.5 N log2 N, N the tensor's transform size, times its batch's
FLOPS='function size(s,  a, k, i, n) { k = split(s, a, "x"); n = 1; for (i = 1; i <= k; i++) { sub(/[^0-9].*/, "", a[i]); n *= a[i] } return n }
function flops(c, t,  p, n, v) { split(t, p, /[*]/); n = size(p[1]); v = (2 in p) ? size(p[2]) : 1; return (c ~ /c/ ? 5 : 2.5) * v * n * (n > 1 ? log(n) / log(2) : 1) }'

{
	echo "== uname"
	uname -a
	echo "== cpu"
	lscpu 2> /dev/null || sysctl machdep.cpu.brand_string hw.ncpu hw.l1dcachesize hw.l2cachesize hw.l3cachesize 2> /dev/null || grep -m1 'model name' /proc/cpuinfo
	grep -m1 '^isa' /proc/cpuinfo 2> /dev/null # RISC-V's, whose lscpu may name no model
	echo "== build"
	grep -E "^CMAKE_(C|CXX)_COMPILER:|^CMAKE_(C|CXX)_FLAGS(_RELEASE)?:|^CMAKE_BUILD_TYPE:|^CMAKE_GENERATOR:|^CMAKE_OSX_ARCHITECTURES:" "$B/CMakeCache.txt"
	echo "emulator: $EMU"
	echo "== versions"
	grep -h -E "^set\([A-Z0-9]+_(VERSION|RELEASE|COMMIT) " "$HERE"/cmake/*.cmake
	echo "image: ${ImageOS:-} ${ImageVersion:-}"
	sw_vers 2> /dev/null
	for repo in "$HERE" "$TOP"; do
		echo "== commits of $repo"
		git -C "$repo" rev-parse HEAD 2> /dev/null
		git -C "$repo" status --short --untracked-files=no 2> /dev/null | head -20
		git -C "$repo" submodule status --recursive 2> /dev/null
	done
	echo "== rounds"
	echo "$ROUNDS"
} > "$R/sysinfo.txt" 2>&1

status=0
if command -v ctest > /dev/null; then
	(cd "$B" && ctest -C Release -L check -j 2 --output-on-failure) > "$R/ctest.txt" 2>&1 # w/o --test-dir, which a board's CMake 3.16 lacks
	status=$?
	grep -q '^No tests were found' "$R/ctest.txt" && status=1 # which older ctests exit 0 on
	echo "exit $status" >> "$R/ctest.txt"
fi

set -f # problems as rof1024*16 aren't globs
# "class tensor problem" for each of CLASSES at each size, the problem libbench2's, w/o the class's precision
for c in $CLASSES; do
	t=${c%%:*}
	l=${t%%N*}
	while read -r n; do
		case "$c" in *:*) [ "$n" -le "${c#*:}" ] || continue;; esac
		p=$(echo "${t#?}" | sed "s/N/$n/g")
		echo "$l ${p#"${l#?}"} $p"
	done < "$R/sizes.txt"
done > "$R/problems.txt"
# libbench2's -<option> <problem> for each line of file $2's
asked() {
	awk -v o="$1" '{printf "%s %s ", o, $3}' "$2"
}
if [ -z "$BOARD" ]; then # a board's info.txt and sizes.txt are scripts/marks', its problems srof's
	for b in $NAMES; do
		x="$D/bin/$b/bench"
		mkdir -p "$R/$b"
		run $EMU "$x" --info-all > "$R/$b/info.txt" 2>&1
		s=$(case "$(run $EMU "$x" --print-precision 2> /dev/null)" in double*) echo d;; *) echo s;; esac)
		awk -v s="$s" 'substr($1, 1, 1) == s' "$R/problems.txt" > "$R/$b/asked.txt"
		: > "$R/$b/problems.txt"
		[ ! -s "$R/$b/asked.txt" ] || run $EMU "$x" $(asked --can-do "$R/$b/asked.txt") | paste -d' ' "$R/$b/asked.txt" - |
			awk 'NF==4 && $4=="#t" {print $1, $2, $3}' > "$R/$b/problems.txt"
		awk '$1=="srof" {print $2}' "$R/$b/problems.txt" > "$R/$b/sizes.txt"
		some="$R/$b/problems.txt"
		if [ -n "$EMU" ] || [ "${K2FFT_ACCURACY:-}" = p2 ]; then
			# powers of two only, as the reference FFT is slow under QEMU and on slow boards
			awk '{k = split($2, d, /[x*]/); for (i = 1; i <= k; i++) {n = d[i]; sub(/[^0-9].*/, "", n); n += 0; while (n > 1 && n%2 == 0) n /= 2; if (n != 1) next} print}' "$some" > "$R/$b/problems-p2.txt"
			some="$R/$b/problems-p2.txt"
		fi
		run $EMU "$x" $(asked -a "$some") 2> /dev/null | paste -d' ' "$some" - |
			awk -v b="${b%-d}" 'NF==9 {print b, $1, $2, $4, $5, $6, $7, $8, $9}' >> "$R/accuracy.txt"
	done
fi

# "name class tensor instructions" as benchFFT's lines, 1 instruction = 1 ns
counts() {
	awk "$FLOPS"' {printf "%s %s %s %.8g %.8g 0\n", $1, $2, $3, flops($2, $3)/($4*1e-3), $4*1e-9}'
}
skip=pffft_twin # the noise floor's twin, which counts don't need
if [ -n "$BOARD" ]; then
	# no command line: tools/count-all.c does every size in one run, scripts/marks counts its trace
	NM=$(sed -n 's/^CMAKE_NM:[A-Z]*=//p' "$B/CMakeCache.txt")
	for b in $NAMES; do
		case " $skip " in *" $b "*) continue;; esac
		mkdir -p "$R/$b"
		timeout 3600 $EMU "$D/bin/$b/count-all" -accel tcg,one-insn-per-tb=on -d exec,nochain 2>&1 > "$R/$b/out.txt" |
			sh "$HERE/scripts/marks" "$b" "$R/$b" "$NM" "$D/bin/$b/count-all" || status=1
	done > "$R/counts.txt" # scripts/marks' lines
elif [ -z "$EMU" ]; then
	for r in $(seq 1 "$ROUNDS"); do
		order=$NAMES
		if [ $((r%2)) = 0 ]; then
			order=$(echo $NAMES | awk '{for (i = NF; i > 0; i--) printf "%s ", $i}') # so no benchee always goes first
		fi
		while read -r l t p <&3; do
			for b in $order; do
				grep -qxF "$l $t $p" "$R/$b/problems.txt" || continue
				m=$(run $PIN "$D/bin/$b/bench" --report-benchmark --time-min 0.01 -s "$p" 2> /dev/null | tail -1)
				case "$m" in "" | *[!0-9.eE+\ -]*) m="FAILED FAILED";; esac
				echo "${b%-d} $l $t $m" >> "$R/speed.txt"
			done
		done 3< "$R/problems.txt"
		for b in $order; do
			awk '{print $3}' "$R/$b/problems.txt" > "$R/$b/problems.list"
			run $PIN "$D/bin/$b/cost" "$R/$b/problems.list" 2> /dev/null |
				awk -v b="${b%-d}" "$FLOPS"' NR==FNR {l[$3] = $1; t[$3] = $2; next}
					!/^#/ && NF==3 && $3>0 && ($1 in l) {printf "%s %s %s %.8g %.8g 0\n", b, l[$1], t[$1], flops(l[$1], t[$1])/$3, $3*1e-6}' "$R/$b/problems.txt" - >> "$R/busy.txt"
		done
	done
	mkdir -p "$R/measures"
	while read -r name flags; do
		[ -n "$name" ] || continue
		each=$(echo " $flags" | sed -n 's/.* each=\([^ ]*\).*/\1/p' | tr ',' ' ')
		if [ -n "$each" ]; then
			for a in $each; do
				run $PIN "$D/bin/measures/$name" "$a"
			done > "$R/measures/$name.txt" 2>&1
		else
			run $PIN "$D/bin/measures/$name" > "$R/measures/$name.txt" 2>&1
		fi
	done < "$R/measures.txt"
else
	# instructions per transform, (N(3)-N(1))/2 so first-call work drops out, at the sizes K2FFT does: tools/insn.c where the
	# emulator loads QEMU plugins (CI builds one), as the same count as -one-insn-per-tb -d exec's lines, w/o a line per instruction
	ours=""
	if grep -qx 'K2FFT' "$R/benchees.txt"; then # K2FFT's problems, in either precision
		ours="$R/ours.txt"
		cat "$R/K2FFT/problems.txt" > "$ours"
		[ ! -f "$R/K2FFT-d/problems.txt" ] || cat "$R/K2FFT-d/problems.txt" >> "$ours"
	fi
	plugin=""
	trace() {
		if [ -n "$plugin" ]; then
			$EMU -E LD_BIND_NOW=1 -E K2FFT_NORACE="$4" -plugin "$plugin" -d plugin "$1" -oestimate "$2" "$3" 2>&1 > /dev/null | sed -n 's/^insns //p'
		else
			$EMU -E LD_BIND_NOW=1 -E K2FFT_NORACE="$4" -one-insn-per-tb -d exec,nochain "$1" -oestimate "$2" "$3" 2>&1 > /dev/null | grep -c '^Trace'
		fi
	}
	how="a trace line per instruction"
	if $EMU -h 2> /dev/null | grep -q -- '-plugin' && cc -O2 -shared -fPIC -o "$B/insn.so" "$HERE/tools/insn.c"; then
		plugin="$B/insn.so"
		first=$(echo $NAMES | cut -d' ' -f1)
		q=$(trace "$D/bin/$first/count" "$(awk 'NR==1 {print $3}' "$R/$first/problems.txt")" 1 1)
		[ "${q:-0}" -gt 0 ] && how="tools/insn.c, a QEMU plugin" || plugin="" # loaded and counting, else the lines
	fi
	echo "counted by: $how" >> "$R/sysinfo.txt"
	for b in $NAMES; do
		case " $skip " in *" $b "*) continue;; esac
		while read -r l t p <&3; do
			[ -z "$ours" ] || grep -qxF "$l $t $p" "$ours" || continue
			best=""
			for k in $(seq 1 16); do # K2FFT: each candidate its race would time (K2FFT_NORACE=k, up to kernel/planner.c's CANDIDATES), keeping the fastest, as the race
				q1=$(trace "$D/bin/$b/count" "$p" 1 "$k")
				q3=$(trace "$D/bin/$b/count" "$p" 3 "$k")
				[ "$q1" -gt 0 ] && [ "$q3" -gt "$q1" ] || break # no k-th
				q=$(( (q3-q1)/2 ))
				[ -n "$best" ] && [ "$best" -le "$q" ] || best=$q
				case "$b" in K2FFT | K2FFT-d) ;; *) break;; esac
			done
			[ -z "$best" ] || echo "${b%-d} $l $t $best"
		done 3< "$R/$b/problems.txt"
	done | counts > "$R/counts.txt"
fi

if [ -s "$R/speed.txt" ]; then
	perl "$HERE/scripts/median.pl" < "$R/speed.txt" | sh "$HERE/scripts/mktbl" > "$R/summary.txt"
elif [ -s "$R/counts.txt" ]; then
	sh "$HERE/scripts/mktbl" < "$R/counts.txt" > "$R/summary.txt"
else
	echo "no measurements in $R" >&2
	status=1
fi
[ -f "$R/summary.txt" ] && cat "$R/summary.txt"
echo "done: $(ls "$R" | wc -l) entries in $R"
exit $status
