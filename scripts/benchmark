#!/bin/bash
# Copyright (c) 2011-2026 0MV7DQ @ The Antisonic Research Institute

# usage: bash scripts/benchmark <build dir> <results dir> [rounds]   (default 5)
# results as benchFFT's lines, "name srof n mflops time setup" (speed.txt, busy.txt, counts.txt) and
# "name srof n L1 L2 Linf L1 L2 Linf" (accuracy.txt); scripts/collect makes the documents from them
set -u
if [ $# -lt 2 ]; then
	sed -n 's/^# usage: //p' "$0" >&2
	exit 2
fi
B=$(cd "$1" && pwd)
D=$(sed -n 's/^PUREfft_BINARY_DIR:[A-Z]*=//p' "$B/CMakeCache.txt" 2> /dev/null)
if [ ! -f "$D/benchees.txt" ]; then
	echo "no benchees in $B: configure with PUREfft's benchmarks (PUREFFT_BENCH) and build first" >&2
	exit 2
fi
mkdir -p "$2"
R=$(cd "$2" && pwd)
ROUNDS=${3:-5}
HERE=$(cd "$(dirname "$0")/.." && pwd)
TOP=$(sed -n 's/^CMAKE_HOME_DIRECTORY:[A-Z]*=//p' "$B/CMakeCache.txt")
# CMake's files and Windows' programs end their lines with CR LF
run() {
	"$@" | tr -d '\r'
}
for f in benchees sizes measures; do
	tr -d '\r' < "$D/$f.txt" > "$R/$f.txt"
done
NAMES=$(cat "$R/benchees.txt")
EMU=$(tr -d '\r' < "$D/emulator.txt" | tr ';' ' ') # a toolchain file's emulator isn't in the cache
BOARD=""
case "$EMU" in qemu-system-*) BOARD=yes;; esac # bare metal, which has count-all alone
PIN=""
if [ -z "$EMU" ] && command -v taskset > /dev/null && [ "$(nproc 2> /dev/null || echo 1)" -gt 1 ]; then
	PIN="taskset -c 1" # one core, like Pd's DSP thread
fi
rm -f "$R/speed.txt" "$R/busy.txt" "$R/counts.txt" "$R/accuracy.txt" "$R/summary.txt"

{
	echo "== uname"
	uname -a
	echo "== cpu"
	lscpu 2> /dev/null || sysctl machdep.cpu.brand_string hw.ncpu hw.l1dcachesize hw.l2cachesize hw.l3cachesize 2> /dev/null || grep -m1 'model name' /proc/cpuinfo
	grep -m1 '^isa' /proc/cpuinfo 2> /dev/null # RISC-V's, whose lscpu may name no model
	echo "== build"
	grep -E "^CMAKE_(C|CXX)_COMPILER:|^CMAKE_BUILD_TYPE:|^CMAKE_GENERATOR:|^CMAKE_OSX_ARCHITECTURES:" "$B/CMakeCache.txt"
	echo "emulator: $EMU"
	echo "== versions"
	grep -h -E "^set\([A-Z0-9]+_(VERSION|RELEASE|COMMIT) " "$HERE"/cmake/*.cmake
	echo "image: ${ImageOS:-} ${ImageVersion:-}"
	sw_vers 2> /dev/null
	for repo in "$HERE" "$TOP"; do
		echo "== commits of $repo"
		git -C "$repo" rev-parse HEAD 2> /dev/null
		git -C "$repo" status --short --untracked-files=no 2> /dev/null | head -20
		git -C "$repo" submodule status --recursive 2> /dev/null
	done
	echo "== rounds"
	echo "$ROUNDS"
} > "$R/sysinfo.txt" 2>&1

status=0
if command -v ctest > /dev/null; then
	(cd "$B" && ctest -C Release -L check -j 2 --output-on-failure) > "$R/ctest.txt" 2>&1 # w/o --test-dir, which a board's CMake 3.16 lacks
	status=$?
	grep -q '^No tests were found' "$R/ctest.txt" && status=1 # which older ctests exit 0 on
	echo "exit $status" >> "$R/ctest.txt"
fi

# libbench2's arguments "$1 rof<n>" for each size in file $2
problems() {
	for n in $(cat "$2"); do
		printf -- "%s rof%s " "$1" "$n"
	done
}
if [ -z "$BOARD" ]; then # a board's info.txt and sizes.txt are scripts/marks'
	for b in $NAMES; do
		x="$D/bin/$b/bench"
		mkdir -p "$R/$b"
		run $EMU "$x" --info-all > "$R/$b/info.txt" 2>&1
		run $EMU "$x" $(problems --can-do "$R/sizes.txt") | paste -d' ' "$R/sizes.txt" - | awk '$2=="#t" {print $1}' > "$R/$b/sizes.txt"
		sizes="$R/$b/sizes.txt"
		if [ -n "$EMU" ]; then
			awk '{n = $1; while (n%2 == 0) n /= 2} n == 1' "$R/$b/sizes.txt" > "$R/$b/sizes-p2.txt" # powers of two only, as the reference FFT is slow under QEMU
			sizes="$R/$b/sizes-p2.txt"
		fi
		run $EMU "$x" $(problems -a "$sizes") 2> /dev/null | paste -d' ' "$sizes" - | awk -v b="$b" 'NF==7 {print b, "srof", $0}' >> "$R/accuracy.txt"
	done
fi

# "name n instructions" as benchFFT's lines, 1 instruction = 1 ns
counts() {
	awk '{printf "%s srof %d %.8g %.8g 0\n", $1, $2, 2.5*$2*log($2)/log(2)/($3*1e-3), $3*1e-9}'
}
skip=pffft_twin # the noise floor's twin, which counts don't need
if [ -n "$BOARD" ]; then
	# no command line: tools/count-all.c does every size in one run, scripts/marks counts its trace
	NM=$(sed -n 's/^CMAKE_NM:[A-Z]*=//p' "$B/CMakeCache.txt")
	for b in $NAMES; do
		case " $skip " in *" $b "*) continue;; esac
		mkdir -p "$R/$b"
		timeout 3600 $EMU "$D/bin/$b/count-all" -accel tcg,one-insn-per-tb=on -d exec,nochain 2>&1 > "$R/$b/out.txt" |
			sh "$HERE/scripts/marks" "$b" "$R/$b" "$NM" "$D/bin/$b/count-all"
	done | counts > "$R/counts.txt"
elif [ -z "$EMU" ]; then
	for r in $(seq 1 "$ROUNDS"); do
		order=$NAMES
		if [ $((r%2)) = 0 ]; then
			order=$(echo $NAMES | awk '{for (i = NF; i > 0; i--) printf "%s ", $i}') # so no benchee always goes first
		fi
		for n in $(cat "$R/sizes.txt"); do
			for b in $order; do
				grep -qx "$n" "$R/$b/sizes.txt" || continue
				t=$(run $PIN "$D/bin/$b/bench" --report-benchmark --time-min 0.01 -s "rof$n" 2> /dev/null | tail -1)
				case "$t" in "" | *[!0-9.eE+\ -]*) t="FAILED FAILED";; esac
				echo "$b srof $n $t" >> "$R/speed.txt"
			done
		done
		for b in $order; do
			run $PIN "$D/bin/$b/cost" "$R/$b/sizes.txt" 2> /dev/null | awk -v b="$b" '!/^#/ && NF==3 && $3>0 {printf "%s srof %d %.8g %.8g 0\n", b, $1, 2.5*$1*log($1)/log(2)/$3, $3*1e-6}' >> "$R/busy.txt"
		done
	done
	mkdir -p "$R/measures"
	while read -r name flags; do
		[ -n "$name" ] || continue
		each=$(echo " $flags" | sed -n 's/.* each=\([^ ]*\).*/\1/p' | tr ',' ' ')
		if [ -n "$each" ]; then
			for a in $each; do
				run $PIN "$D/bin/measures/$name" "$a"
			done > "$R/measures/$name.txt" 2>&1
		else
			run $PIN "$D/bin/measures/$name" > "$R/measures/$name.txt" 2>&1
		fi
	done < "$R/measures.txt"
else
	# instructions per transform, (N(3)-N(1))/2 so first-call work drops out: QEMU's -one-insn-per-tb -d exec,
	# at the sizes PUREfft does; a race's choice follows emulated time, so a raced PUREfft is counted by its paths
	ours=$(grep -x 'PUREfft' "$R/benchees.txt" > /dev/null && echo "$R/PUREfft/sizes.txt")
	trace() {
		$EMU -E LD_BIND_NOW=1 -one-insn-per-tb -d exec,nochain "$1" -oestimate "$2" "$3" 2>&1 > /dev/null | grep -c '^Trace'
	}
	grep -q '^PUREfft_' "$R/benchees.txt" && skip="$skip PUREfft"
	for b in $NAMES; do
		case " $skip " in *" $b "*) continue;; esac
		for n in $(cat "$R/$b/sizes.txt"); do
			[ -z "$ours" ] || grep -qx "$n" "$ours" || continue
			q1=$(trace "$D/bin/$b/count" "$n" 1)
			q3=$(trace "$D/bin/$b/count" "$n" 3)
			if [ "$q1" -gt 0 ] && [ "$q3" -gt "$q1" ]; then
				echo "$b $n $(( (q3-q1)/2 ))"
			fi
		done
	done | counts > "$R/counts.txt"
fi

if [ -s "$R/speed.txt" ]; then
	perl "$HERE/scripts/median.pl" < "$R/speed.txt" | sh "$HERE/scripts/mktbl" > "$R/summary.txt"
elif [ -s "$R/counts.txt" ]; then
	sh "$HERE/scripts/mktbl" < "$R/counts.txt" > "$R/summary.txt"
else
	echo "no measurements in $R" >&2
	status=1
fi
[ -f "$R/summary.txt" ] && cat "$R/summary.txt"
echo "done: $(ls "$R" | wc -l) entries in $R"
exit $status
