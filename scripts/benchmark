#!/bin/bash
# Copyright (c) 2011-2026 0MV7DQ @ The Antisonic Research Institute

# usage: bash scripts/benchmark <build dir> <results dir> [rounds]   (default 5)
set -u
if [ $# -lt 2 ]; then
	sed -n 's/^# usage: //p' "$0" >&2
	exit 2
fi
B=$(cd "$1" && pwd)
D=$(sed -n 's/^PUREfft_BINARY_DIR:[A-Z]*=//p' "$B/CMakeCache.txt" 2> /dev/null)
if [ ! -f "$D/benchees.txt" ]; then
	echo "no benchees in $B: configure with PUREfft's benchmarks (PUREFFT_BENCH) and build first" >&2
	exit 2
fi
mkdir -p "$2"
R=$(cd "$2" && pwd)
ROUNDS=${3:-5}
HERE=$(cd "$(dirname "$0")/.." && pwd)
TOP=$(sed -n 's/^CMAKE_HOME_DIRECTORY:[A-Z]*=//p' "$B/CMakeCache.txt")
NAMES=$(cat "$D/benchees.txt")
EMU=$(tr ';' ' ' < "$D/emulator.txt") # a toolchain file's emulator isn't in the cache
PIN=""
if [ -z "$EMU" ] && command -v taskset > /dev/null && [ "$(nproc 2> /dev/null || echo 1)" -gt 1 ]; then
	PIN="taskset -c 1" # one core, like Pd's DSP thread
fi
cp "$D/benchees.txt" "$D/measures.txt" "$R/"

{
	echo "== uname"
	uname -a
	echo "== cpu"
	lscpu 2> /dev/null || sysctl machdep.cpu.brand_string hw.ncpu hw.l1dcachesize hw.l2cachesize hw.l3cachesize 2> /dev/null || grep -m1 'model name' /proc/cpuinfo
	echo "== build"
	grep -E "^CMAKE_(C|CXX)_COMPILER:|^CMAKE_BUILD_TYPE:|^CMAKE_GENERATOR:" "$B/CMakeCache.txt"
	echo "emulator: $EMU"
	for repo in "$HERE" "$TOP"; do
		echo "== commits of $repo"
		git -C "$repo" rev-parse HEAD 2> /dev/null
		git -C "$repo" status --short --untracked-files=no 2> /dev/null | head -20
		git -C "$repo" submodule status --recursive 2> /dev/null
	done
	echo "== rounds"
	echo "$ROUNDS"
} > "$R/sysinfo.txt" 2>&1

if command -v ctest > /dev/null; then
	ctest --test-dir "$B" -C Release -L check -j 2 --output-on-failure > "$R/ctest.txt" 2>&1
	echo "exit $?" >> "$R/ctest.txt"
fi

# "$1 rof<n>" for each size benchee $2 can do
problems() {
	for n in $(cat "$R/$2/sizes.txt"); do
		printf -- "%s rof%s " "$1" "$n"
	done
}
for b in $NAMES; do
	x="$D/bin/$b/bench"
	mkdir -p "$R/$b"
	rm -f "$R/$b"/speed-*.txt "$R/$b"/cost-*.txt
	$EMU "$x" --info-all > "$R/$b/info.txt" 2>&1
	$EMU "$x" $(for n in $(cat "$D/sizes.txt"); do printf -- "--can-do rof%s " "$n"; done) | paste -d' ' "$D/sizes.txt" - | awk '$2=="#t" {print $1}' > "$R/$b/sizes.txt"
	$EMU "$x" $(problems -a $b) > "$R/$b/accuracy.txt" 2>&1
	$EMU "$x" -v1 --verify-rounds 10 $(problems -y $b) > "$R/$b/verify.txt" 2>&1
	echo "exit $?" >> "$R/$b/verify.txt"
done

if [ -z "$EMU" ]; then
	for r in $(seq 1 "$ROUNDS"); do
		order=$NAMES
		if [ $((r%2)) = 0 ]; then
			order=$(echo $NAMES | awk '{for (i = NF; i > 0; i--) printf "%s ", $i}') # so no benchee always goes first
		fi
		for b in $order; do
			$PIN "$D/bin/$b/bench" --report-benchmark $(problems -s $b) > "$R/$b/speed-$r.txt" 2>&1
			$PIN "$D/bin/$b/cost" "$R/$b/sizes.txt" > "$R/$b/cost-$r.txt" 2>&1
		done
	done
	mkdir -p "$R/measures"
	while read -r name flags; do
		[ -n "$name" ] || continue
		each=$(echo " $flags" | sed -n 's/.* each=\([^ ]*\).*/\1/p' | tr ',' ' ')
		if [ -n "$each" ]; then
			for a in $each; do
				$PIN "$D/bin/measures/$name" "$a"
			done > "$R/measures/$name.txt" 2>&1
		else
			$PIN "$D/bin/measures/$name" > "$R/measures/$name.txt" 2>&1
		fi
	done < "$D/measures.txt"
fi

if [ "$(uname)" = Linux ]; then
	Q=$EMU
	[ -n "$Q" ] || Q="qemu-$(uname -m) -cpu max"
	{
		echo "# instructions per transform, the same program counted two ways: QEMU's ((N(20)-N(0))/20, -one-insn-per-tb -d exec)"
		echo "# and the CPU's counter (perf, instructions:u, (N(200)-N(0))/200). -oestimate keeps FFTW's plan the same between runs"
		for b in $NAMES; do
			for n in 1024 2304; do
				x="$D/bin/$b/count"
				grep -qx "$n" "$R/$b/sizes.txt" || continue
				hw=n/a
				if [ -z "$EMU" ] && command -v perf > /dev/null; then
					h0=$(perf stat -x, -e instructions:u "$x" -oestimate $n 0 2>&1 > /dev/null | awk -F, '/instructions/{print $1}')
					h1=$(perf stat -x, -e instructions:u "$x" -oestimate $n 200 2>&1 > /dev/null | awk -F, '/instructions/{print $1}')
					case "$h0$h1" in *[!0-9]* | "") ;; *) hw=$(((h1-h0)/200));; esac
				fi
				qm=n/a
				if command -v ${Q%% *} > /dev/null; then # -one-insn-per-tb needs QEMU 8.1
					q0=$($Q -one-insn-per-tb -d exec,nochain "$x" -oestimate $n 0 2>&1 > /dev/null | grep -c '^Trace')
					q1=$($Q -one-insn-per-tb -d exec,nochain "$x" -oestimate $n 20 2>&1 > /dev/null | grep -c '^Trace')
					if [ "$q0" -gt 0 ] && [ "$q1" -gt "$q0" ]; then
						qm=$(((q1-q0)/20))
					fi
				fi
				echo "$b $n hardware $hw qemu $qm"
			done
		done
	} > "$R/counts.txt" 2>&1
fi

# medians of the rounds, fastest first
if [ -z "$EMU" ]; then
	for b in $NAMES; do
		for r in $(seq 1 "$ROUNDS"); do
			paste -d' ' "$R/$b/sizes.txt" "$R/$b/speed-$r.txt" | awk -v b="$b" 'NF>=3 {printf "%s %s speed %.4f\n", $1, b, $3*1e6}'
			awk -v b="$b" '!/^#/ && NF==3 {printf "%s %s busy %.4f\n", $1, b, $3}' "$R/$b/cost-$r.txt"
		done
	done | sort -k1,1n -k2,2 -k3,3 -k4,4g | awk '
		function flush(){ if (c) print last, (c%2 ? v[(c+1)/2] : (v[c/2]+v[c/2+1])/2) }
		{ k = $1 " " $2 " " $3; if (k != last){ flush(); last = k; c = 0 } v[++c] = $4 }
		END { flush() }' | awk '
		{ if ($3 == "speed") s[$1 " " $2] = $4; else u[$1 " " $2] = $4 }
		END { for (k in s) print k, s[k], (k in u ? u[k] : "-") }' | sort -k1,1n -k3,3g | awk '
		BEGIN { print "# us per transform, median of the rounds: libbench2, and busy (after 256 KB of other writes)" }
		$1 != n { n = $1; print "" }
		{ printf "%7s  %-20s %10s %10s\n", $1, $2, $3, $4 }' > "$R/summary.txt"
	cat "$R/summary.txt"
fi
echo "done: $(ls "$R" | wc -l) entries in $R"
