#!/bin/sh
# Copyright (c) 2011-2026 0MV7DQ @ The Antisonic Research Institute

# usage: sh scripts/table <benchmark dir> > kernel/table.h
# kernel/planner.c's wisdom, as FFTW's: each architecture's problems (class and tensor) and the codes no rival beat there, fastest first, from
# <dir>/<machine>/<machine>.fastest (scripts/collect); one architecture's machines merged by rank, the first 4 kept (the first the planner races);
# each class's first row, tensor "*", every code its machines ran it with, so the planner races the kernels they didn't
set -u
if [ $# -ne 1 ]; then
	sed -n 's/^# usage: //p' "$0" >&2
	exit 2
fi

# the test a machine's build passes, by its label
arch(){
	case $1 in
	cortex-m55*) echo 'defined(__ARM_FEATURE_MVE)' ;;
	cortex-m33*) echo 'defined(__ARM_ARCH_8M_MAIN__)' ;;
	cortex-m4-* | cortex-m7-*) echo 'defined(__ARM_ARCH_7EM__)' ;;
	esp32-*) echo 'defined(CONFIG_IDF_TARGET_ESP32)' ;;
	esp32s3-*) echo 'defined(CONFIG_IDF_TARGET_ESP32S3)' ;;
	linux-x64*) echo 'defined(__linux__) && defined(__x86_64__)' ;;
	linux-i686*) echo 'defined(__linux__) && defined(__i386__)' ;;
	linux-arm64*) echo 'defined(__linux__) && defined(__aarch64__)' ;;
	linux-armhf* | linux-armv6*) echo 'defined(__linux__) && defined(__arm__)' ;;
	linux-riscv64*) echo 'defined(__linux__) && defined(__riscv)' ;;
	linux-mips64el*) echo 'defined(__linux__) && defined(__mips__)' ;;
	linux-ppc64le*) echo 'defined(__linux__) && defined(__powerpc64__)' ;;
	linux-s390x*) echo 'defined(__linux__) && defined(__s390x__)' ;;
	macos-x64*) echo 'defined(__APPLE__) && defined(__x86_64__)' ;;
	macos-arm64*) echo 'defined(__APPLE__) && defined(__aarch64__)' ;;
	windows-x64*) echo 'defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__))' ;;
	windows-arm64*) echo 'defined(_WIN32) && (defined(_M_ARM64) || defined(__aarch64__))' ;;
	*) return 1 ;;
	esac
}

for f in "$1"/*/*.fastest; do
	m=$(basename "$f" .fastest)
	if ! a=$(arch "$m"); then
		echo "table: $m left out: no architecture for its label" >&2
		continue
	fi
	cat "${f%.fastest}.speed" "${f%.fastest}.counts.speed" "${f%.fastest}.cycles.speed" 2> /dev/null | tr -d '\r' |
		awk -v a="$a" -v m="$m" '$1 !~ /^K2FFT/ && $1 != "pffft_twin" && NF >= 3 {print a "\t" m "\t" $2 "\t*\t" $1}'
	tr -d '\r' < "$f" | sed -n 's/^\([a-z]*\) \([^:]*\): *\([^|]*[^| ]\).*/\1\t\2\t\3/p' | awk -F '\t' -v a="$a" -v m="$m" '{print a "\t" m "\t" $0}'
done | awk -F '\t' '
	!($1 in seen) {seen[$1] = 1; archs[++na] = $1}
	!(($1, $3) in classes) {classes[$1, $3] = 1; order[$1] = order[$1] " " $3}
	$4 == "*" {
		if (!index(" " ran[$1, $3] " ", " " $5 " ")) {
			ran[$1, $3] = ran[$1, $3] (ran[$1, $3] == "" ? "" : " ") $5
		}
		next
	}
	!index(" " names[$1] " ", " " $2 " ") {names[$1] = names[$1] " " $2}
	!(($1, $3, $4) in count) {tensors[$1, $3] = tensors[$1, $3] " " $4}
	{ranked[$1, $3, $4, ++count[$1, $3, $4]] = $5}
	END {
		print "/* generated by scripts/table from benchmark/: each problem'"'"'s codes no rival beat, fastest first */"
		print "#pragma once"
		print "#ifdef ESP_PLATFORM"
		print "#include <sdkconfig.h> /* CONFIG_IDF_TARGET_* */"
		print "#endif"
		print "#include <stddef.h>"
		print ""
		print "static const struct {"
		print "\tconst char *cls; /* benchFFT'"'"'s problem class, as kernel/problem.c names it */"
		print "\tconst char *tensor; /* \"*\": every code the machines ran it with */"
		print "\tconst char *codes;"
		print "} table[] = {"
		for (i = 1; i <= na; i++) {
			a = archs[i]
			printf("#%s %s /*%s */\n", (i == 1) ? "if" : "elif", a, names[a])
			nc = split(substr(order[a], 2), cls, " ")
			for (c = 1; c <= nc; c++) {
				printf("\t{\"%s\", \"*\", \"%s\"},\n", cls[c], ran[a, cls[c]])
				n = split(substr(tensors[a, cls[c]], 2), s, " ")
				for (j = 1; j <= n; j++) {
					merged = ""
					kept = 0
					for (r = 1; kept < 4; r++) { # each machine'"'"'s r-th, then the next rank
						more = 0
						for (k = 1; k <= count[a, cls[c], s[j]] && kept < 4; k++) {
							if (split(ranked[a, cls[c], s[j], k], code, " ") < r) {
								continue
							}
							more = 1
							if (!index(" " merged " ", " " code[r] " ")) {
								merged = merged (merged == "" ? "" : " ") code[r]
								kept++
							}
						}
						if (!more) {
							break
						}
					}
					printf("\t{\"%s\", \"%s\", \"%s\"},\n", cls[c], s[j], merged)
				}
			}
		}
		if (na) {
			print "#endif"
		}
		print "\t{NULL, NULL, NULL}"
		print "};"
	}'
