#!/bin/sh
# Copyright (c) 2011-2026 0MV7DQ @ The Antisonic Research Institute

# usage: sh scripts/collect <results dir> <out dir> [baseline dir]
# one machine's documents from scripts/benchmark's results, as benchFFT's collect and desc2web.sh make them:
# <out>/<machine>/ with .speed .busy.speed .counts.speed .accuracy .info .sysinfo .ctest .measures, mktbl's .tbl,
# scripts/figure's plots, and .fastest; the machine is the results folder's name and the CPU model
set -u
if [ $# -lt 2 ]; then
	sed -n 's/^# usage: //p' "$0" >&2
	exit 2
fi
sd=$(cd "$(dirname "$0")" && pwd)
R=$(cd "$1" && pwd)
if [ ! -f "$R/summary.txt" ]; then # the runner's last file: a run cut short (a job's time limit, a lost board) leaves the machine's last documents
	echo "incomplete: $(basename "$R"), its documents kept"
	exit 1
fi
mkdir -p "$2"
O=$(cd "$2" && pwd)
base=${3:-}
emu=$(sed -n 's/^emulator: *//p' "$R/sysinfo.txt" | head -1)
cpu=$(echo "$emu" | sed -n 's/.*-cpu \([^ ]*\).*/\1/p; s/.*-M \([^ ]*\).*/\1/p' | head -1)
if [ -z "$emu" ]; then # the host's model; an emulator w/o -cpu runs its default, so the label alone names it
	cpu=$(sed -n '/^== cpu/,/^== /{s/^Model name: *//p; s/^machdep.cpu.brand_string: *//p; s/^model name\t*: *//p; s/^isa\t*: *//p}' "$R/sysinfo.txt" | head -1)
	cpu=${cpu:-unknown}
fi
cpu=$(echo "$cpu" | sed 's/([RrTtMm]*)//g; s/ CPU//; s/ @.*//; s/[^A-Za-z0-9.]\{1,\}/-/g; s/^-//; s/-$//' | tr 'A-Z' 'a-z')
m=$(basename "$R")${cpu:+_$cpu}
M="$O/$m"
mkdir -p "$M"

# a run measures some classes (scripts/benchmark's K2FFT_CLASSES): the machine's documents keep the others' lines from earlier runs
now=" $(cat "$R/speed.txt" "$R/counts.txt" 2> /dev/null | awk '{print $2}' | sort -u | tr '\n' ' ') "
kept() { # <document> <class field>: its lines of the classes this run didn't measure, from <out>'s, else the baseline's
	d="$M/$m.$1"
	[ -f "$d" ] || d="$base/$m/$m.$1"
	[ -f "$d" ] && awk -v now="$now" -v f="$2" '!/^#/ && NF >= f && !index(now, " " $f " ")' "$d"
	return 0
}
{ kept speed 2; grep -v '^pffft_twin ' "$R/speed.txt" 2> /dev/null | perl "$sd/median.pl"; } > "$M/$m.speed.new"
{ kept busy.speed 2; grep -v '^pffft_twin ' "$R/busy.txt" 2> /dev/null | perl "$sd/median.pl"; } > "$M/$m.busy.speed.new"
counts=counts
[ -n "$emu" ] || counts=cycles # a real board's cycle counter, kept apart from QEMU's instructions
{ kept $counts.speed 2; grep -v '^pffft_twin ' "$R/counts.txt" 2> /dev/null; } > "$M/$m.$counts.speed.new"
{ kept accuracy 2; cat "$R/accuracy.txt" 2> /dev/null; } > "$M/$m.accuracy.new"
kept fastest 1 > "$M/$m.fastest.kept"
for f in speed busy.speed $counts.speed accuracy; do
	mv "$M/$m.$f.new" "$M/$m.$f"
done
cp "$R/sysinfo.txt" "$M/$m.sysinfo"
cp "$R/ctest.txt" "$M/$m.ctest" 2> /dev/null
for b in $(cat "$R/benchees.txt"); do
	[ -f "$R/$b/info.txt" ] || continue # pffft_twin isn't counted on bare metal
	echo "("
	cat "$R/$b/info.txt"
	echo ")"
done > "$M/$m.info"
for f in "$R"/measures/*.txt; do
	[ -f "$f" ] || continue
	echo "== $(basename "$f" .txt)"
	cat "$f"
done > "$M/$m.measures"
[ -s "$M/$m.measures" ] || rm -f "$M/$m.measures" # emulated machines measure none

cd "$M"
for f in "$m.speed" "$m.busy.speed" "$m.$counts.speed" "$m.accuracy"; do
	[ -s "$f" ] || { rm -f "$f"; continue; }
	case "$f" in *.accuracy) ;; *) sh "$sd/mktbl" < "$f" > "${f%.speed}.tbl";; esac
done

old=""
[ -n "$base" ] && [ -f "$base/$m/$m.fastest" ] && old="$base/$m/$m.fastest"
status=0
if [ -s "$R/speed.txt" ]; then
	perl "$sd/fastest.pl" ${old:+-c "$old"} "$R/speed.txt" "$R/busy.txt" > "$m.fastest" 2> "$m.verdicts" || status=1
elif [ -s "$R/counts.txt" ]; then
	perl "$sd/fastest.pl" -f 0.15 ${old:+-c "$old"} "$R/counts.txt" > "$m.fastest" 2> "$m.verdicts" || status=1
	what="QEMU instruction counts"
	[ -n "$emu" ] || what="the board's cycle counts" # a real board's, as its sysinfo names no emulator
	sed -i.bak "1s/.*/# $what, one round: codes no rival beat by more than 15%/" "$m.fastest" && rm -f "$m.fastest.bak"
fi
[ -f "$m.fastest" ] && cat "$m.fastest.kept" >> "$m.fastest" # the classes earlier runs measured
rm -f "$m.fastest.kept"
python3 "$sd/figure" . # after .fastest, whose codes it plots
[ -z "$old" ] && [ -f "$m.fastest" ] && echo "new: $m has no baseline" >> "$m.verdicts"
if [ ! -f "$m.ctest" ]; then
	echo "integrity: no checks recorded" >> "$m.verdicts"
	status=1
elif ! grep -q '^exit 0$' "$m.ctest"; then
	echo "integrity: ctest failed" >> "$m.verdicts"
	status=1
fi

echo "== $m"
cat "$m.verdicts" 2> /dev/null
[ -f "$m.fastest" ] && sed '1d; s/^[a-z]* [^:]*: //; s/ |.*//' "$m.fastest" | tr ' ' '\n' | grep . | sort | uniq -c | sort -rn | awk '{printf "  fastest at %d problems: %s\n", $1, $2}'
exit $status
