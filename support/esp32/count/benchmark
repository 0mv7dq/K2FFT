# usage: bash support/esp32/count/benchmark <results dir> [esp32s3|esp32]   (in ESP-IDF's environment, after its export.sh)
# scripts/benchmark's bare-metal counts on an emulated ESP32-S3 or ESP32: each benchee's tools/count-all.c built by ESP-IDF, run
# under QEMU with one instruction a nanosecond (so FreeRTOS's tick comes every 10 M), and its trace counted by scripts/marks
set -u
if [ $# -lt 1 ]; then
	sed -n 's/^# usage: //p' "$0" >&2
	exit 2
fi
HERE=$(cd "$(dirname "$0")/../../.." && pwd)
mkdir -p "$1"
R=$(cd "$1" && pwd)
T=${2:-esp32s3}
NAMES="K2FFT pffft kissfft pocketfft cmsis espdsp"
EMU="qemu-system-xtensa -M $T" # as idf.py runs it, for scripts/collect's machine name
printf '%s\n' $NAMES > "$R/benchees.txt"
: > "$R/failed.txt" # ctest.txt is the esp32 job's, whose checks run under idf.py qemu before this
for b in $NAMES; do
	B="$HERE/build/$T-count-$b"
	mkdir -p "$R/$b"
	if ! idf.py -C "$HERE/support/esp32/count" -B "$B" -D BENCHEE="$b" set-target "$T" build > "$R/$b/build.txt" 2>&1; then
		echo "$b: the build failed, see $R/$b/build.txt" >&2
		echo "$b" >> "$R/failed.txt"
		continue
	fi
	NM=$(sed -n 's/^CMAKE_NM:[A-Z]*=//p' "$B/CMakeCache.txt")
	NM=${NM:-xtensa-$T-elf-nm}
	# idf.py runs QEMU in the foreground, so its -d log is idf.py's stderr, as scripts/benchmark's boards
	timeout 3600 idf.py -C "$HERE/support/esp32/count" -B "$B" qemu \
		--qemu-extra-args="-no-reboot -icount shift=0 -accel tcg,one-insn-per-tb=on -d exec,nochain" < /dev/null 2>&1 > "$R/$b/out.txt" |
		sh "$HERE/scripts/marks" "$b" "$R/$b" "$NM" "$B/k2fft_count.elf" || echo "$b" >> "$R/failed.txt"
done > "$R/counts.txt" # scripts/marks' lines, as scripts/benchmark's
B="$HERE/build/$T-count-K2FFT"
{
	echo "== uname"
	uname -a
	echo "== cpu"
	lscpu 2> /dev/null
	echo "== build"
	"$(sed -n 's/^CMAKE_C_COMPILER:[A-Z]*=//p' "$B/CMakeCache.txt")" --version | head -1
	idf.py --version
	echo "emulator: $EMU"
	echo "== versions"
	grep -h -E "^set\([A-Z0-9]+_(VERSION|RELEASE|COMMIT) " "$HERE/cmake/cmsis.cmake"
	awk '/espressif\/esp-dsp:/ {f = 1} f && /^ *version:/ {print "set(ESPDSP_VERSION " $2 ") # dependencies.lock"; exit}' "$B/dependencies.lock"
	echo "== commits of $HERE"
	git -c safe.directory='*' -C "$HERE" rev-parse HEAD # the container's checkout is another user's
	echo "== rounds"
	echo 1
} > "$R/sysinfo.txt" 2>&1
sh "$HERE/scripts/mktbl" < "$R/counts.txt" > "$R/summary.txt"
cat "$R/summary.txt"
echo "done: $(wc -l < "$R/counts.txt") counts in $R"
[ -s "$R/counts.txt" ] && [ ! -s "$R/failed.txt" ]
